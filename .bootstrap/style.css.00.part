:root{font-family:Tahoma,"Microsoft Sans Serif",Arial,sans-serif;font-size:11px;color:#000;--face:#ece9d8;--blue:#0054e3;--scroll:17px}*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden}body{background:#3a6ea5;user-select:none;-webkit-user-select:none;overscroll-behavior:none}button,input,select,textarea{font:inherit;color:inherit}button{cursor:default}button:disabled{color:#aca899;text-shadow:1px 1px #fff}button:focus-visible{outline:1px dotted #000;outline-offset:-4px}[hidden]{display:none!important}.xp-window{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(1080px,calc(100% - 64px));height:min(730px,calc(100% - 76px));min-width:245px;min-height:170px;display:flex;flex-direction:column;background:var(--face);border:3px solid #0055ea;border-top:0;border-radius:8px 8px 0 0;box-shadow:1px 2px 8px #0006;overflow:hidden}.xp-window.maximized{left:0!important;top:0!important;width:100%!important;height:100%!important;transform:none!important;border-radius:0;box-shadow:none}.titlebar{height:30px;min-height:30px;background:linear-gradient(#3d95ff 0,#1783ff 7%,#086cf6 13%,#0055e9 42%,#0055e9 70%,#075ce7 86%,#1268f1 95%,#0341ba);border-top:1px solid #78a6ed;box-shadow:inset 0 1px 0 #ffffff42;display:flex;align-items:center;padding:0 3px 0 3px;color:#fff;font:700 13px "Trebuchet MS",Tahoma,Arial,sans-serif;letter-spacing:.1px;text-shadow:1px 1px #0f3c9c;touch-action:none}.app-icon{width:18px;height:20px;object-fit:contain;margin-right:4px}.titlebar>span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}.window-controls{display:flex;gap:2px;margin-left:6px}.caption-button{position:relative;width:22px;height:22px;padding:0;border:1px solid #fff;border-radius:3px;box-shadow:inset 1px 1px 1px #c3dcff,inset -1px -1px 1px #0043a7;background:linear-gradient(135deg,#78aeff,#0b5adb 65%);color:white}.caption-button:hover{filter:brightness(1.16)}.caption-button:active{filter:brightness(.88)}.caption-button.close{background:linear-gradient(135deg,#eeac96,#e76b48 32%,#e03b1e 75%,#bd230d);box-shadow:inset 1px 1px 1px #ffd4c7,inset -1px -1px 1px #a9250b}.caption-button.minimize i{position:absolute;left:4px;bottom:4px;width:8px;height:3px;background:white}.caption-button.maximize i{position:absolute;left:4px;top:4px;width:12px;height:11px;border:2px solid white;border-top-width:3px}.maximized .caption-button.maximize i{width:9px;height:9px;left:4px;top:7px;box-shadow:2px -3px 0 -1px #1b69e8,3px -4px 0 0 #fff}.caption-button.close i:before,.caption-button.close i:after{position:absolute;content:"";left:9px;top:3px;width:2px;height:14px;background:#fff;transform:rotate(45deg)}.caption-button.close i:after{transform:rotate(-45deg)}.menubar{display:flex;align-items:center;height:20px;min-height:20px;padding-left:0;background:var(--face);border-bottom:1px solid #d6d2c2;gap:0}.menubar>button{height:19px;padding:1px 7px 2px;background:transparent;border:1px solid transparent;white-space:nowrap}.menubar>button:hover,.menubar>button.open{background:#316ac5;color:#fff;border-color:#316ac5}.menubar u{text-decoration:none}.show-access .menubar u{text-decoration:underline}.editor-frame{flex:1;min-height:0;display:grid;grid-template-columns:minmax(0,1fr) var(--scroll);grid-template-rows:minmax(0,1fr) var(--scroll);margin:0 0 0 0;border-left:1px solid #7f9db9;border-top:1px solid #7f9db9;background:#fff}.editor-frame.wrapped{grid-template-rows:minmax(0,1fr);}.editor{position:relative;overflow:hidden;background:#fff;cursor:text;outline:none;touch-action:none;grid-row:1;grid-column:1;min-width:0;min-height:0}.editor canvas{display:block;position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none}.text-input{position:absolute;z-index:2;width:3px;min-width:3px;height:18px;padding:0;border:0;margin:0;resize:none;opacity:.015;color:transparent;background:transparent;caret-color:transparent;outline:none;overflow:hidden;white-space:pre;touch-action:none;font-size:16px!important}.text-input::selection{background:transparent;color:transparent}#composition{position:absolute;z-index:3;background:#fff;color:#000;border-bottom:1px solid #000;white-space:pre;pointer-events:none}.scrollbar{background:#f3f1e7;display:flex;overflow:hidden;touch-action:none}.vertical{grid-column:2;grid-row:1;flex-direction:column;border-left:1px solid #fff}.horizontal{grid-column:1;grid-row:2;border-top:1px solid #fff}.scroll-arrow{flex-shrink:0;width:16px;height:16px;border:1px solid #fff;border-radius:2px;background:linear-gradient(135deg,#e3e9fa,#c3d4f3);box-shadow:inset 0 0 0 1px #b2c5ec;position:relative;padding:0}.scroll-arrow:hover,.scroll-thumb:hover{filter:brightness(1.035)}.scroll-arrow:active,.scroll-thumb:active{filter:brightness(.95)}.scroll-arrow i{position:absolute;width:5px;height:5px;border-top:2px solid #4d6185;border-left:2px solid #4d6185;left:5px;top:5px;transform:rotate(45deg)}.vertical .last i{transform:rotate(225deg);top:4px}.horizontal .first i{transform:rotate(-45deg);left:6px}.horizontal .last i{transform:rotate(135deg);left:4px}.scroll-track{flex:1;position:relative;min-height:0;min-width:0;background:repeating-linear-gradient(45deg,#f6f4ec 0,#f6f4ec 1px,#efede5 1px,#efede5 2px)}.scroll-thumb{position:absolute;border:1px solid white;border-radius:2px;background:linear-gradient(90deg,#e0e8f9,#bfd1f1);box-shadow:inset 0 0 0 1px #a7bfe8;min-height:17px;min-width:16px}.vertical .scroll-thumb{width:16px;left:0}.horizontal .scroll-thumb{height:16px;top:0;background:linear-gradient(#e0e8f9,#bfd1f1)}.scroll-thumb b{position:absolute;left:5px;top:calc(50% - 3px);width:5px;height:7px;background:repeating-linear-gradient(#97b2dd 0,#97b2dd 1px,#f2f6ff 1px,#f2f6ff 2px)}.horizontal .scroll-thumb b{left:calc(50% - 3px);top:5px;width:7px;height:5px;background:repeating-linear-gradient(90deg,#97b2dd 0,#97b2dd 1px,#f2f6ff 1px,#f2f6ff 2px)}.scrollbar.disabled .scroll-thumb{display:none}.scrollbar.disabled .scroll-arrow i{border-color:#b5c2db}.scroll-corner{grid-row:2;grid-column:2;background:var(--face);border-top:1px solid #fff;border-left:1px solid #fff}.statusbar{height:22px;min-height:22px;display:flex;align-items:stretch;padding:2px 1px 1px;border-top:1px solid #f3f1e6;gap:2px}.statusbar>span{border-left:1px solid #aca899;border-top:1px solid #aca899;border-right:1px solid #fff;border-bottom:1px solid #fff;display:flex;align-items:center;padding:0 5px}.statusbar>span:first-child{flex:1}.statusbar>span:nth-child(2){width:155px}.statusbar i{width:12px;background:repeating-linear-gradient(135deg,transparent 0,transparent 2px,#aaa69a 2px,#aaa69a 3px,#fff 3px,#fff 4px);clip-path:polygon(100% 0,100% 100%,0 100%)}#resize-grip{position:absolute;bottom:0;right:0;width:12px;height:12px;cursor:nwse-resize;touch-action:none}.maximized #resize-grip{display:none}.restore-task{position:absolute;left:12px;bottom:8px;min-width:170px;max-width:300px;height:28px;padding:2px 9px;background:linear-gradient(#3c8eec,#1c62ba);border:1px solid #164d9b;border-radius:3px;box-shadow:inset 1px 1px 1px #87baff;color:white;font-weight:bold;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.restore-task img{width:18px;height:18px;vertical-align:middle;margin-right:4px}.popup-menu{position:fixed;z-index:200;background:#fff;border:1px solid #aca899;box-shadow:2px 2px 2px #0005;padding:2px;min-width:165px}.popup-menu button{display:flex;align-items:center;position:relative;width:100%;height:20px;white-space:nowrap;background:transparent;border:0;padding:2px 15px 2px 21px;text-align:left;gap:28px}.popup-menu button .shortcut{margin-left:auto}.popup-menu button:hover:not(:disabled),.popup-menu button:focus:not(:disabled){background:#316ac5;color:#fff;outline:0}.popup-menu button.checked:before{content:"✓";position:absolute;left:5px;font-size:13px;font-weight:700}.popup-menu hr{height:1px;border:0;background:#d5d2c8;margin:3px 2px}.popup-menu button:disabled{color:#aca899;text-shadow:none}.dialog-shade{position:fixed;inset:0;z-index:300;display:flex;align-items:center;justify-content:center;background:transparent;pointer-events:auto;padding:8px}.dialog-shade.modeless{pointer-events:none}.xp-dialog{background:var(--face);border:3px solid #0055ea;border-top:0;border-radius:8px 8px 0 0;box-shadow:2px 3px 8px #0005;max-width:calc(100vw - 12px);max-height:calc(100dvh - 12px);display:flex;flex-direction:column;overflow:hidden;pointer-events:auto;min-width:230px}.xp-dialog>.titlebar{height:29px;min-height:29px;padding-left:5px;font-size:13px}.xp-dialog>.titlebar .caption-button{width:21px;height:21px}.dialog-content{padding:12px;overflow:auto;font-size:11px;line-height:1.35}.xp-button{background:linear-gradient(#fff 0,#f9f8f4 55%,#efede4 90%,#e4e0d5);border:1px solid #003c74;border-radius:3px;min-width:75px;min-height:23px;padding:3px 12px;box-shadow:inset -1px -1px 0 #d6d0bf,inset 1px 1px 0 #fff}.xp-button:hover{box-shadow:inset 0 0 0 2px #ffce79}.xp-button:active{background:#e5e2d5;box-shadow:inset 1px 1px 1px #9d9d92}.xp-button.default{box-shadow:inset 0 0 0 2px #a8c2e7}.xp-button:disabled{border-color:#c9c7ba;background:#f1efe6;box-shadow:none}.dialog-actions{display:flex;justify-content:flex-end;gap:6px;margin-top:14px}.dialog-content input:not([type=checkbox]):not([type=radio]),.dialog-content select,.dialog-content textarea{background:#fff;border:1px solid #7f9db9;border-radius:0;min-height:21px;padding:2px 3px;user-select:text;-webkit-user-select:text;outline-offset:-2px}.dialog-content select{padding:1px 2px}.dialog-content input[type=checkbox],.dialog-content input[type=radio]{accent-color:#316ac5;width:13px;height:13px;vertical-align:middle;margin:0 5px 0 0}.dialog-content label{white-space:nowrap}.dialog-content fieldset{border:1px solid #d0d0bf;border-radius:3px;padding:10px;margin:0;min-width:0}.dialog-content legend{padding:0 4px}.field{display:flex;align-items:center;gap:8px;margin-bottom:9px}.field>input,.field>select{flex:1;min-width:0}.field>label{min-width:72px}.find-layout{display:grid