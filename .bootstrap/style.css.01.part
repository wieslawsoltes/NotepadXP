;grid-template-columns:minmax(0,1fr) 86px;gap:8px 14px}.find-fields .field{margin-bottom:8px}.find-fields input{width:200px}.find-buttons{display:flex;flex-direction:column;gap:6px}.find-options{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:12px}.find-options fieldset{padding:6px 9px;display:flex;gap:10px}.font-lists{display:grid;grid-template-columns:1.5fr 1.1fr .6fr;gap:12px}.font-col{min-width:0;display:flex;flex-direction:column;gap:3px}.font-col input{width:100%;margin-top:2px}.font-col select{width:100%;height:115px;padding:0}.font-col select option{padding:1px 3px}.font-bottom{display:grid;grid-template-columns:1fr 130px;gap:16px;margin-top:16px}.font-sample{height:88px;overflow:hidden;display:flex;justify-content:center;align-items:center;background:transparent}.font-actions{display:flex;flex-direction:column;gap:6px}.file-toolbar{display:flex;align-items:center;gap:7px;margin-bottom:8px}.file-toolbar select{flex:1}.small-tool{background:transparent;border:1px solid transparent;height:25px;min-width:25px;padding:2px 4px;font-size:16px}.small-tool:hover{border-color:#7f9db9;background:#e2ebfa}.file-main{height:230px;display:flex;gap:8px;margin-bottom:9px}.places{width:90px;flex-shrink:0;background:#e9e6d8;display:flex;flex-direction:column}.places button{flex:1;padding:4px 1px;background:transparent;border:1px solid transparent;font-size:10px;white-space:normal}.places button:hover,.places button.selected{border-color:#7f9db9;background:#dfe8f6}.places .place-icon{display:block;font-size:22px;height:27px;line-height:25px}.file-list{flex:1;min-width:0;background:#fff;border:1px solid #7f9db9;overflow:auto;display:flex;align-content:flex-start;flex-wrap:wrap;padding:3px}.file-item{display:flex;align-items:center;gap:4px;min-width:120px;max-width:100%;height:23px;padding:2px 4px;border:1px solid transparent;background:#fff;text-align:left;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.file-item img{width:17px;height:17px}.file-item.selected{background:#316ac5;color:white}.empty-folder{color:#777;padding:12px;text-align:center;width:100%;line-height:1.7}.file-bottom{display:grid;grid-template-columns:1fr 90px;gap:8px 12px}.file-bottom .field{margin-bottom:7px}.file-bottom .field label{min-width:76px}.file-bottom .field input,.file-bottom .field select{width:100%}.file-buttons{display:flex;flex-direction:column;gap:8px}.file-note{color:#666;font-size:10px;margin:2px 0 0}.message-layout{display:flex;align-items:center;gap:15px;min-height:46px}.message-icon{font:700 30px Georgia,serif;border:2px solid #316ac5;background:#fff;color:#316ac5;border-radius:50%;width:35px;height:35px;flex:0 0 35px;text-align:center;line-height:31px}.message-layout p{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}.about-header{font-family:"Trebuchet MS",Arial,sans-serif;font-size:29px;font-weight:700;letter-spacing:-1px;color:#111;margin:0 0 4px}.about-header sup{color:#ed6d19;font-size:16px;letter-spacing:0;font-weight:normal}.about-sub{font-size:16px;margin-bottom:16px}.about-rule{height:1px;background:#aaa;border:0}.about-layout{display:flex;gap:18px;margin:18px 0}.about-layout img{width:42px;height:42px}.muted{color:#666}.help-content{line-height:1.65;user-select:text;-webkit-user-select:text}.help-content h3{font-size:13px;margin:15px 0 5px;color:#003399}.help-content h3:first-child{margin-top:0}.help-content p{margin:5px 0 10px}.help-content kbd{font:11px Tahoma;border:1px solid #aaa;background:#fff;padding:0 3px;border-radius:2px}.help-content table{width:100%;border-collapse:collapse}.help-content td{padding:3px;border-bottom:1px solid #d8d5c6;vertical-align:top}.agent-status{border:1px solid #b9b6a7;background:#fff;padding:9px;margin-bottom:12px;line-height:1.6;user-select:text;-webkit-user-select:text}.agent-status strong{color:#003399}.agent-log{height:115px;overflow:auto;border:1px solid #7f9db9;background:white;padding:5px;font:10px "Courier New",monospace;white-space:pre-wrap;user-s