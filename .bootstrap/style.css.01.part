@media(max-width:600px),(max-height:420px){.xp-window{left:0;top:0;transform:none;width:100%;height:100dvh;max-width:none;max-height:none;border-radius:0}.dialog-content{padding:10px}.xp-dialog{max-height:calc(100dvh - 8px)}.dialog-shade{padding:4px}.find-layout{gap:8px;grid-template-columns:minmax(0,1fr) 80px}.find-fields .field{align-items:flex-start;flex-direction:column;gap:3px}.find-fields input{width:100%}.find-options{flex-wrap:wrap;gap:8px;margin-top:8px}.find-options fieldset{padding:5px}.file-main{height:180px}.places{width:70px}.places button{font-size:9px}.file-bottom{grid-template-columns:minmax(0,1fr) 77px;gap:7px}.file-bottom .field{flex-wrap:wrap;gap:3px}.file-bottom .field label{min-width:60px}.file-bottom .field input,.file-bottom .field select{flex-basis:100%}.file-toolbar{gap:4px}.font-lists{gap:6px}.font-bottom{grid-template-columns:1fr 80px;gap:8px}.page-grid{grid-template-columns:1fr}.page-preview{display:none}.margins-grid{gap:6px}.menubar>button{padding-left:7px;padding-right:7px}}
@media(pointer:coarse){.popup-menu button{height:29px}.xp-button{min-height:29px}.dialog-content input:not([type=checkbox]):not([type=radio]),.dialog-content select{min-height:25px}.scrollbar{--scroll:17px}.file-item{height:29px}.caption-button:before{content:"";position:absolute;inset:-4px}.selection-handle{width:28px}.selection-handle:before{left:13px}.selection-handle:after{left:7px}}
@media print{body>*{display:none!important}}
